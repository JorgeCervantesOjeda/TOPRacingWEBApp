FRAGMENT "Authentication Entry" {
  WIDTH 28;
  DRAW { 1, 2, 4, 6 };
  TRANSITION from 1 to 2 if user clicks "Log In";
  TRANSITION from 2 to 2 if user types "Email" AND "The user updates the login email";
  TRANSITION from 2 to 2 if user types "Password" AND "The user updates the login password";
  TRANSITION from 2 to 6 if user clicks "Login" AND "Credentials are valid";
  TRANSITION from 2 to 4 if user clicks "Login" AND "Credentials are invalid";
  TRANSITION from 4 to 2 if user clicks "OK";
}

FRAGMENT "Account Creation" {
  WIDTH 28;
  DRAW { 2, 3, 6, 8 };
  TRANSITION from 2 to 3 if user clicks "Create Account";
  TRANSITION from 3 to 3 if user types "Password" AND "The participant updates the password";
  TRANSITION from 3 to 3 if user types "Given Names" AND "The participant updates the given names";
  TRANSITION from 3 to 3 if user types "Family Names" AND "The participant updates the family names";
  TRANSITION from 3 to 3 if user types "Email" AND "The participant updates the email address";
  TRANSITION from 3 to 3 if user types "Phone Number" AND "The participant updates the phone number";
  TRANSITION from 3 to 8 if user clicks "View Venues";
  TRANSITION from 8 to 3 if user clicks "Select Venue" AND "The account form is the previous UI";
  TRANSITION from 8 to 3 if user clicks "Return" AND "The account form is the previous UI";
  TRANSITION from 3 to 6 if user clicks "Save Data" AND "Participant data is valid and the account is created";
}

