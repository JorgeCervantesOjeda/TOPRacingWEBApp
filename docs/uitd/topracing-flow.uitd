UITD "TOPRacing Full Flow" {
UI 1 "Public Welcome" actions {
  clicks "Log In";
}

UI 2 "Login" actions {
  types "Email";
  types "Password";
  clicks "Login";
  clicks "Create Account";
}

UI 3 "Create Account Form" actions {
  types "Password";
