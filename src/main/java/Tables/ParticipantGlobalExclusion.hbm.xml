<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="Tables.ParticipantGlobalExclusion" table="participant_global_exclusion" catalog="topracing26" optimistic-lock="version">
        <id name="id" type="java.lang.Long">
            <column name="id" />
            <generator class="identity" />
        </id>
        <many-to-one name="participant" class="Tables.Participant" fetch="select">
            <column name="id_participant" not-null="true" />
        </many-to-one>
        <property name="active" type="boolean">
            <column name="active" not-null="true" />
        </property>
        <property name="reason" type="string">
            <column name="reason" length="512" />
        </property>
        <property name="createdAt" type="timestamp">
            <column name="created_at" length="19" not-null="true" />
        </property>
        <property name="resolvedAt" type="timestamp">
            <column name="resolved_at" length="19" />
        </property>
        <many-to-one name="createdByParticipant" class="Tables.Participant" fetch="select">
            <column name="id_created_by" />
        </many-to-one>
        <many-to-one name="resolvedByParticipant" class="Tables.Participant" fetch="select">
            <column name="id_resolved_by" />
        </many-to-one>
    </class>
</hibernate-mapping>
